# ---------
# Project environment variables
# ---------

# Project Settings
PROJECT_NAME=concierge
PROJECT_LOG_LEVEL=INFO

# Microsoft Foundry Settings
AZURE_AI_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
# Realtime model dedicated Foundry endpoint. When empty, the realtime feature is
# disabled and /conversations/{id}/realtime closes with 4503. Realtime models are
# only available in selected regions (locations), so this can be set independently
# of AZURE_AI_PROJECT_ENDPOINT to point at a different Foundry resource.
# Examples:
#   https://<resource>.openai.azure.com/
#   https://<resource>.services.ai.azure.com/
AZURE_AI_PROJECT_ENDPOINT_REALTIME=

# Observability Settings
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=concierge
# Web / worker entrypoints toggle observability with env vars.
# CLI entrypoints use --tracing / --mlflow.
CONCIERGE_TRACING_ENABLED=false
CONCIERGE_MLFLOW_ENABLED=false
# Pre-flight reachability check for the MLflow tracking server. When the
# server does not respond within this many seconds, MLflow autologging is
# skipped (with a warning) instead of blocking startup on MLflow's internal
# HTTP retry loop. Only applies to http(s) tracking URIs.
# MLFLOW_HEALTH_CHECK_TIMEOUT_SECONDS=3.0
# Fail-fast defaults applied to MLflow's REST client (via the
# MLFLOW_HTTP_REQUEST_TIMEOUT / MLFLOW_HTTP_REQUEST_MAX_RETRIES env vars).
# Set lower / higher to trade latency for resilience.
# MLFLOW_HTTP_REQUEST_TIMEOUT_SECONDS=5.0
# MLFLOW_HTTP_REQUEST_MAX_RETRIES=1

# PostgreSQL (pgvector) Settings - defaults match `compose.yml`
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=concierge
POSTGRES_PASSWORD=concierge
POSTGRES_DB=concierge
POSTGRES_COLLECTION=concierge_docs

# Azure Database for PostgreSQL Flexible Server Settings
# Used by `scripts/postgresql/vanilla.py --target azure`. Variable names follow the
# Microsoft Learn guide
# (https://learn.microsoft.com/en-us/azure/postgresql/azure-ai/generative-ai-develop-with-langchain)
# but are prefixed with `AZURE_` here to disambiguate them from the local pgvector
# `POSTGRES_*` variables above.
AZURE_DBHOST=<server-name>.postgres.database.azure.com
AZURE_DBNAME=postgres
AZURE_DBPORT=5432
AZURE_SSLMODE=require
# Set AZURE_USE_ENTRA_AUTH=true to authenticate via Microsoft Entra ID
# (an access token from DefaultAzureCredential is used as the password).
# AZURE_DBUSER must then be the Entra principal name registered as a PostgreSQL role.
AZURE_USE_ENTRA_AUTH=true
AZURE_DBUSER=<entra-principal-or-db-user>
# AZURE_DBPASSWORD is only required when AZURE_USE_ENTRA_AUTH=false.
AZURE_DBPASSWORD=

# ---------
# Todo App persistence backend selection
# ---------
# Read by `concierge.settings.TodoSettings`. The value must match one of
# the `concierge.settings.TodoRepositoryBackend` enum members below.
# memory (default) | postgres | azure-postgres
TODO_REPOSITORY_BACKEND=memory
# Optional: override the Todo table name (default: todo_tasks)
# TODO_TABLE_NAME=todo_tasks

# -----------------------------------------------------------------------------
# Shared agent runtime (used by cloud_agent worker and chat)
# -----------------------------------------------------------------------------
# Required for `langgraph-echo` agent. Uses init_chat_model() format
# (e.g. "azure_ai:gpt-5", "azure_ai:gpt-4o-mini", "openai:gpt-4o").
# Foundry endpoint is taken from AZURE_AI_PROJECT_ENDPOINT (above).
AGENTS_LANGGRAPH_MODEL=azure_ai:gpt-5
# Optional: override the system prompt for langgraph-echo agent.
# AGENTS_LANGGRAPH_SYSTEM_PROMPT=

# ---------
# Chat App persistence backend selection
# ---------
# memory (default) | postgres | azure-postgres
CHAT_REPOSITORY_BACKEND=memory
# Optional: override table names
# CHAT_CONVERSATIONS_TABLE_NAME=chat_conversations
# CHAT_PARTICIPANTS_TABLE_NAME=chat_participants
# CHAT_MESSAGES_TABLE_NAME=chat_messages
# Optional: default sender UUID for chat CLI
# CHAT_USER_ID=<uuid>
# Switch the chat bot reply backend (foundry|agent). foundry by default.
CHAT_RESPONDER_BACKEND=foundry
CHAT_BOT_AGENT_TYPE=langgraph-echo

# ---------
# Chat App realtime voice
# ---------
# Foundry realtime model deployment name (e.g. gpt-realtime, gpt-realtime-1.5, gpt-realtime-mini)
CHAT_REALTIME_MODEL=gpt-realtime-1.5
# alloy | ash | ballad | coral | echo | sage | shimmer | verse
CHAT_REALTIME_VOICE=alloy
CHAT_REALTIME_LOCALE=ja-JP
# Optional: session safety limit (seconds)
CHAT_REALTIME_MAX_SESSION_SECONDS=600

# ---------
# Cloud Agent App (async task dispatch)
# ---------
# All Cloud Agent settings are aggregated in `concierge.settings.CloudAgentSettings`
# and read via the `CLOUD_AGENT_` prefix. See docs/cloud_agent/index.md
# ("Configuration") for backend selection details and end-to-end examples.

# Task persistence backend: memory (default) | postgres | azure-postgres
# - memory:         in-process dict; data lost on restart. Worker and API must
#                   live in the same process to see each other's tasks.
# - postgres:       reuses the `POSTGRES_*` variables above (Docker Compose).
# - azure-postgres: reuses the `AZURE_*` variables above (Flexible Server +
#                   optional Entra ID auth).
CLOUD_AGENT_REPOSITORY_BACKEND=memory
# Optional: override the SQL table name (default: cloud_agent_tasks)
# CLOUD_AGENT_TABLE_NAME=cloud_agent_tasks

# Job queue backend: memory (default) | azure-storage-queue
# - memory:              in-process asyncio.Queue (same-process only).
# - azure-storage-queue: durable queue; main queue and DLQ are auto-created
#                        on startup.
CLOUD_AGENT_QUEUE_BACKEND=memory
# Queue resource names (used by the azure-storage-queue backend).
CLOUD_AGENT_QUEUE_NAME=cloud-agent-tasks
CLOUD_AGENT_DLQ_NAME=cloud-agent-dlq
# Required when CLOUD_AGENT_QUEUE_BACKEND=azure-storage-queue.
# Authentication is performed exclusively via Microsoft Entra ID using
# DefaultAzureCredential (`az login`, managed identity, workload identity, ...).
# Connection strings / account keys are NOT supported.
# Grant the caller the 'Storage Queue Data Contributor' role on the account.
# Example: https://<account>.queue.core.windows.net
CLOUD_AGENT_AZURE_STORAGE_ACCOUNT_URL=

# Worker / queue tuning. Visibility timeout must exceed the worst-case agent
# execution time. max_retries is the default retry budget (overridable per
# dispatch via the API / CLI). worker_concurrency is reserved for future
# concurrent processing - scale horizontally for now.
CLOUD_AGENT_VISIBILITY_TIMEOUT_SECONDS=60
CLOUD_AGENT_MAX_RETRIES=3
CLOUD_AGENT_WORKER_CONCURRENCY=1
CLOUD_AGENT_POLL_INTERVAL_SECONDS=1.0
