# =============================================================================
# Concierge environment configuration
# =============================================================================
# This file enumerates every environment variable consumed by
# `concierge.settings.*` (plus a couple of helpers read directly via
# os.getenv) along with its default value defined in code.
#
# Convention:
#   - Variables that are required (no usable default — the corresponding
#     feature will not work until you set them) are left UNCOMMENTED with a
#     placeholder value you must edit.
#   - All other variables are COMMENTED OUT and show the in-code default.
#     Uncomment and edit a line only when you want to override the default.
#
# Tip: search for `class .*Settings` under `concierge/settings/` to see the
# pydantic model behind each variable.

# -----------------------------------------------------------------------------
# Project Settings  -> concierge.settings.ProjectSettings
# -----------------------------------------------------------------------------
PROJECT_NAME=concierge
# PROJECT_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Microsoft Foundry  -> concierge.settings.MicrosoftFoundrySettings
# -----------------------------------------------------------------------------
# Required for every Foundry-backed feature (chat foundry responder, langgraph
# / microsoft-agent-framework / github-copilot-sdk agents, knowledge embeddings
# via the `foundry` provider, scripts/microsoft_foundry/vanilla.py, ...). Leave
# this as-is only if you intend to run with `echo`-style agents and the
# `fake` embedding provider exclusively.
AZURE_AI_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
# Realtime model dedicated Foundry endpoint. When empty (default), the realtime
# feature is disabled and /conversations/{id}/realtime closes with 4503.
# Realtime models are available only in selected regions, so this can point at
# a different Foundry resource than AZURE_AI_PROJECT_ENDPOINT.
# Examples:
#   https://<resource>.openai.azure.com/
#   https://<resource>.services.ai.azure.com/
# AZURE_AI_PROJECT_ENDPOINT_REALTIME=
# Image-generation (gpt-image-2) dedicated Foundry endpoint. When empty
# (default), AZURE_AI_PROJECT_ENDPOINT is reused. gpt-image-2 is GA in a
# limited set of regions, so this can point at a different Foundry project.
# Example: https://<resource>.services.ai.azure.com/api/projects/<project>
# AZURE_AI_PROJECT_ENDPOINT_IMAGE=

# -----------------------------------------------------------------------------
# Observability  -> concierge.settings.ObservabilitySettings
# -----------------------------------------------------------------------------
# MLFLOW_TRACKING_URI=http://127.0.0.1:5000
# MLFLOW_EXPERIMENT_NAME=microsoft-foundry-vanilla
# Web / worker entrypoints toggle observability with these env vars (CLIs use
# --tracing / --mlflow). Enabling CONCIERGE_MLFLOW_ENABLED covers LangChain /
# LangGraph (via mlflow.<flavour>.autolog) AND Microsoft Agent Framework (via
# the OpenTelemetry HTTP exporter pointed at MLflow's /v1/traces endpoint).
# The MAF integration requires an HTTP(S) tracking server; file:/sqlite:
# tracking URIs only receive LangChain traces.
# CONCIERGE_TRACING_ENABLED=false
# CONCIERGE_MLFLOW_ENABLED=false
# Pre-flight reachability check timeout for the MLflow tracking server. If the
# server does not respond within this many seconds, MLflow autologging is
# skipped (with a warning) instead of blocking startup on MLflow's internal
# HTTP retry loop. Only applies to http(s) tracking URIs.
# MLFLOW_HEALTH_CHECK_TIMEOUT_SECONDS=3.0
# Fail-fast defaults forwarded to MLflow's REST client (via the
# MLFLOW_HTTP_REQUEST_TIMEOUT / MLFLOW_HTTP_REQUEST_MAX_RETRIES env vars).
# Set lower / higher to trade latency for resilience.
# MLFLOW_HTTP_REQUEST_TIMEOUT_SECONDS=5.0
# MLFLOW_HTTP_REQUEST_MAX_RETRIES=1

# -----------------------------------------------------------------------------
# PostgreSQL (local pgvector)  -> concierge.settings.PostgresSettings
# -----------------------------------------------------------------------------
# Defaults match the `postgres` service in `compose.yml` so
# `docker compose up postgres` works without further configuration.
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=concierge
# POSTGRES_PASSWORD=concierge
# POSTGRES_DB=concierge
# POSTGRES_COLLECTION=concierge_docs

# -----------------------------------------------------------------------------
# Azure Database for PostgreSQL (Flexible Server)
#   -> concierge.settings.AzurePostgresSettings  (env prefix `AZURE_`)
# -----------------------------------------------------------------------------
# Used by `scripts/postgresql/vanilla.py --target azure` and by the
# `azure-postgres` repository backends (todo / chat / cloud_agent). Variable
# names follow the Microsoft Learn LangChain tutorial
# (https://learn.microsoft.com/en-us/azure/postgresql/azure-ai/generative-ai-develop-with-langchain)
# but are prefixed with `AZURE_` to disambiguate them from the local
# pgvector `POSTGRES_*` variables above.
#
# AZURE_DBHOST / AZURE_DBNAME / AZURE_DBUSER are REQUIRED whenever any of
# *_REPOSITORY_BACKEND is set to `azure-postgres`.
# AZURE_DBHOST=<server-name>.postgres.database.azure.com
# AZURE_DBNAME=postgres
# AZURE_DBUSER=<entra-principal-or-db-user>
# AZURE_DBPORT=5432
# AZURE_SSLMODE=require
# When true (default), an Entra access token from DefaultAzureCredential is
# used as the password and AZURE_DBPASSWORD is ignored. AZURE_DBUSER must
# then be the Entra principal registered as a PostgreSQL role.
# AZURE_USE_ENTRA_AUTH=true
# Required only when AZURE_USE_ENTRA_AUTH=false.
# AZURE_DBPASSWORD=
# Override only if your tenant requires a non-default audience.
# AZURE_ENTRA_TOKEN_SCOPE=https://ossrdbms-aad.database.windows.net/.default

# -----------------------------------------------------------------------------
# Todo App  -> concierge.settings.TodoSettings  (env prefix `TODO_`)
# -----------------------------------------------------------------------------
# Persistence backend: memory (default) | postgres | azure-postgres
# TODO_REPOSITORY_BACKEND=memory
# Table name for SQL backends (ignored by `memory`).
# TODO_TABLE_NAME=todo_tasks

# -----------------------------------------------------------------------------
# Knowledge Indexer
#   -> concierge.settings.KnowledgeSettings  (env prefix `KNOWLEDGE_`)
# -----------------------------------------------------------------------------
# Embedding provider: foundry (default) | fake
# KNOWLEDGE_EMBEDDING_PROVIDER=foundry
# KNOWLEDGE_EMBEDDING_MODEL=text-embedding-3-small
# KNOWLEDGE_VECTOR_SIZE=1536
# Vector store backend (pgvector only at this time).
# KNOWLEDGE_VECTOR_BACKEND=pgvector
# KNOWLEDGE_DEFAULT_COLLECTION=knowledge_default
# Markdown splitter defaults.
# KNOWLEDGE_CHUNK_SIZE=1000
# KNOWLEDGE_CHUNK_OVERLAP=200

# -----------------------------------------------------------------------------
# Shared agent runtime (used by cloud_agent worker and chat)
#   -> concierge.settings.AgentsSettings  (env prefix `AGENTS_`)
# -----------------------------------------------------------------------------
# Model for the `langgraph` agent (init_chat_model format, e.g.
# `azure_ai:gpt-5`, `azure_ai:gpt-4o-mini`, `openai:gpt-4o`). The Foundry
# endpoint is taken from AZURE_AI_PROJECT_ENDPOINT above.
# AGENTS_LANGGRAPH_MODEL=azure_ai:gpt-5
# AGENTS_LANGGRAPH_SYSTEM_PROMPT=You are a helpful assistant. You have access to tools such as `echo` (which simply echoes the user's text back) and `generate_image_tool` (which produces images via gpt-image-2), plus sandboxed file tools such as `read_file`, `list_directory`, and `file_search` (and optional write tools when enabled), and optional shell tool `shell_exec` for allowlisted CLI commands. Pick the appropriate tool based on the user's request: call `echo` for plain echo / smoke-test requests, call `generate_image_tool` with a concise English prompt when the user asks for an image, use file tools for workspace file operations while staying within the sandbox root, and use `shell_exec` only when command execution is required. Return the tool result as your final answer in one sentence.

# Model for the `github-copilot-sdk` agent (Copilot SDK model id).
# AGENTS_GITHUB_COPILOT_SDK_MODEL=gpt-5-mini
# AGENTS_GITHUB_COPILOT_SDK_SYSTEM_PROMPT=You are a helpful assistant. You have access to tools such as `echo` (which simply echoes the user's text back) and `generate_image_tool` (which produces images via gpt-image-2), plus sandboxed file tools such as `read_file`, `list_directory`, and `file_search` (and optional write tools when enabled), and optional shell tool `shell_exec` for allowlisted CLI commands. Pick the appropriate tool based on the user's request: call `echo` for plain echo / smoke-test requests, call `generate_image_tool` with a concise English prompt when the user asks for an image, use file tools for workspace file operations while staying within the sandbox root, and use `shell_exec` only when command execution is required. Return the tool result as your final answer in one sentence.

# Model for the `microsoft-agent-framework` agent. The value is a Foundry
# deployment name (NOT the `<provider>:<name>` init_chat_model format used by
# the `langgraph` agent). Requires AZURE_AI_PROJECT_ENDPOINT and that the
# signed-in principal holds the "Azure AI Developer" role on the Foundry
# project.
# AGENTS_MICROSOFT_AGENT_FRAMEWORK_MODEL=gpt-5
# AGENTS_MICROSOFT_AGENT_FRAMEWORK_SYSTEM_PROMPT=You are a helpful assistant. You have access to tools such as `echo` (which simply echoes the user's text back) and `generate_image_tool` (which produces images via gpt-image-2), plus sandboxed file tools such as `read_file`, `list_directory`, and `file_search` (and optional write tools when enabled), and optional shell tool `shell_exec` for allowlisted CLI commands. Pick the appropriate tool based on the user's request: call `echo` for plain echo / smoke-test requests, call `generate_image_tool` with a concise English prompt when the user asks for an image, use file tools for workspace file operations while staying within the sandbox root, and use `shell_exec` only when command execution is required. Return the tool result as your final answer in one sentence.

# Settings for the `foundry-agent-service` agent (Azure AI Foundry Prompt
# Agent). Unlike `microsoft-agent-framework`, the agent definition (model,
# instructions, tools, knowledge) lives on the Foundry project itself; this
# code only references the agent by name and drives it through
# `openai.responses.create()` with an `agent_reference`. Requires
# AZURE_AI_PROJECT_ENDPOINT and that the signed-in principal holds the
# "Azure AI Developer" role on the Foundry project (needed for the
# `agents.create_version` call on first invocation).
#
# `*_MODEL` is the Foundry deployment name used as `PromptAgentDefinition.model`.
# `*_SYSTEM_PROMPT` is persisted as the Foundry agent's `instructions`;
# changing the value creates a new agent version on the next invocation.
# `*_AGENT_NAME` is the Foundry-side agent name — reuse the same value
# across runs to reuse the existing agent record, or pick a different name
# to isolate environments (dev / staging / prod, ...).
# AGENTS_FOUNDRY_AGENT_SERVICE_MODEL=gpt-5
# AGENTS_FOUNDRY_AGENT_SERVICE_SYSTEM_PROMPT=You are a helpful assistant.
# AGENTS_FOUNDRY_AGENT_SERVICE_AGENT_NAME=concierge-foundry-agent

# File-management tools sandbox root. Empty (default) -> <cwd>/workspace.
# AGENTS_FILE_ROOT_DIR=
# Enabled file tools (comma-separated). Empty string disables all file tools.
# AGENTS_FILE_TOOLS_ENABLED=read_file,list_directory,file_search
# Enabled shell tools (comma-separated). Default empty = disabled (opt-in).
# AGENTS_SHELL_TOOLS_ENABLED=
# Required when shell tools are enabled (comma-separated allowlist of command
# names). Example: terraform,echo
# AGENTS_SHELL_ALLOWED_COMMANDS=
# Shell tools working directory root. Empty -> AGENTS_FILE_ROOT_DIR fallback.
# AGENTS_SHELL_ROOT_DIR=
# Shell command timeout in seconds.
# AGENTS_SHELL_TIMEOUT_SECONDS=30
# Max bytes for stdout/stderr each; output truncated beyond this value.
# AGENTS_SHELL_MAX_OUTPUT_BYTES=65536
# Image generation (gpt-image-2): Foundry deployment name.
# AGENTS_IMAGE_MODEL=gpt-image-2
# Supported sizes: 1024x1024 | 1536x1024 | 1024x1536 | 4K
# AGENTS_IMAGE_SIZE=1024x1024
# Images per request (1-10).
# AGENTS_IMAGE_N=1
# Azure OpenAI API version used by the AzureOpenAI client.
# AGENTS_IMAGE_API_VERSION=2025-04-01-preview

# -----------------------------------------------------------------------------
# Knowledge retrieval tools (registered for LangGraph / MAF / Copilot SDK)
#   -> concierge.settings.AgentsKnowledgeSettings
#      (env prefix `AGENTS_KNOWLEDGE__`)
# -----------------------------------------------------------------------------
# Comma-separated tool names (snake_case, no duplicates). Empty (default) =
# feature disabled (no-op). Each name in this list must have a matching
# AGENTS_KNOWLEDGE__<NAME>__COLLECTION entry; reserved tool names (echo,
# generate_image_tool, read_file, list_directory, file_search, write_file,
# copy_file, move_file, delete_file, shell_exec) cannot be reused.
# AGENTS_KNOWLEDGE__TOOLS=
# Per-tool config (only consulted when AGENTS_KNOWLEDGE__TOOLS lists the tool
# name): COLLECTION is required; DESCRIPTION / TOP_K / MAX_CHARS are optional.
# Defaults: TOP_K=4 (max 20), MAX_CHARS=1200.
# AGENTS_KNOWLEDGE__SEARCH_DOCS__COLLECTION=knowledge_default
# AGENTS_KNOWLEDGE__SEARCH_DOCS__DESCRIPTION=Search the product docs.
# AGENTS_KNOWLEDGE__SEARCH_DOCS__TOP_K=4
# AGENTS_KNOWLEDGE__SEARCH_DOCS__MAX_CHARS=1200
# AGENTS_KNOWLEDGE__SEARCH_RUNBOOKS__COLLECTION=runbooks
# AGENTS_KNOWLEDGE__SEARCH_RUNBOOKS__DESCRIPTION=Search operational runbooks.

# -----------------------------------------------------------------------------
# Chat App  -> concierge.settings.ChatSettings  (env prefix `CHAT_`)
# -----------------------------------------------------------------------------
# Persistence backend: memory (default) | postgres | azure-postgres
# CHAT_REPOSITORY_BACKEND=memory
# CHAT_CONVERSATIONS_TABLE_NAME=chat_conversations
# CHAT_PARTICIPANTS_TABLE_NAME=chat_participants
# CHAT_MESSAGES_TABLE_NAME=chat_messages

# Chat bot reply responder. `foundry` (default) uses the streaming Foundry
# responder and requires AZURE_AI_PROJECT_ENDPOINT. Any other value is
# resolved against the shared AgentRegistry. Built-ins:
#   foundry | echo | langgraph | github-copilot-sdk | microsoft-agent-framework
# CHAT_BOT_AGENT_TYPE=foundry
# CHAT_BOT_PARTICIPANT_ID=00000000-0000-0000-0000-000000000001
# CHAT_BOT_DISPLAY_NAME=Concierge AI
# CHAT_BOT_HISTORY_LIMIT=20
# Model identifier passed to `init_chat_model` by the Foundry responder.
# CHAT_BOT_MODEL=azure_ai:gpt-5
# CHAT_BOT_SYSTEM_PROMPT=あなたは Concierge Chat のアシスタントです。日本語で簡潔に応答してください。

# Default sender UUID for the chat CLI (not a `ChatSettings` field; only
# consumed by `concierge.chat.infrastructure.cli` via os.getenv).
# CHAT_USER_ID=<uuid>

# --- Chat realtime voice ---
# Foundry realtime deployment name (gpt-realtime, gpt-realtime-1.5,
# gpt-realtime-mini, ...).
# CHAT_REALTIME_MODEL=gpt-realtime-1.5
# alloy | ash | ballad | coral | echo | sage | shimmer | verse
# CHAT_REALTIME_VOICE=alloy
# Transcription locale. BCP-47 values like `ja-JP` are reduced to the
# ISO-639-1 primary subtag (`ja`) when forwarded to Foundry.
# CHAT_REALTIME_LOCALE=ja-JP
# CHAT_REALTIME_SYSTEM_PROMPT=あなたは Concierge Chat のアシスタントです。日本語で簡潔に応答してください。
# PCM16 sample rate to/from Foundry (Foundry currently requires 24000 Hz;
# only change if Foundry adds support for other rates).
# CHAT_REALTIME_AUDIO_SAMPLE_RATE_HZ=24000
# Server-side WebSocket safety timeout (seconds).
# CHAT_REALTIME_MAX_SESSION_SECONDS=600
# Azure deployment name for input-audio transcription. Empty (default) omits
# the `transcription` block from session.update so Foundry will not
# transcribe the user's audio (assistant speech still works). The default
# OpenAI model id `gpt-4o-mini-transcribe` does not correspond to an Azure
# deployment in most resources, so leaving this empty avoids silent failures.
# CHAT_REALTIME_TRANSCRIPTION_MODEL=

# -----------------------------------------------------------------------------
# Cloud Agent App (async task dispatch)
#   -> concierge.settings.CloudAgentSettings  (env prefix `CLOUD_AGENT_`)
# -----------------------------------------------------------------------------
# See docs/cloud_agent/index.md ("Configuration") for backend selection
# details and end-to-end examples.

# Task persistence backend: memory (default) | postgres | azure-postgres
#   - memory:         in-process dict; data lost on restart. Worker and API
#                     must live in the same process to see each other's tasks.
#   - postgres:       reuses the `POSTGRES_*` variables above (Docker Compose).
#   - azure-postgres: reuses the `AZURE_*` variables above (Flexible Server +
#                     optional Entra ID auth).
# CLOUD_AGENT_REPOSITORY_BACKEND=memory
# CLOUD_AGENT_TABLE_NAME=cloud_agent_tasks

# Job queue backend: memory (default) | azure-storage-queue
#   - memory:              in-process asyncio.Queue (same-process only).
#   - azure-storage-queue: durable queue; main queue and DLQ are auto-created
#                          on startup.
# CLOUD_AGENT_QUEUE_BACKEND=memory
# CLOUD_AGENT_QUEUE_NAME=cloud-agent-tasks
# CLOUD_AGENT_DLQ_NAME=cloud-agent-dlq
# Required when CLOUD_AGENT_QUEUE_BACKEND=azure-storage-queue. Authentication
# is performed exclusively via Microsoft Entra ID using DefaultAzureCredential
# (`az login`, managed identity, workload identity, ...). Connection strings
# and account keys are NOT supported. Grant the caller the
# 'Storage Queue Data Contributor' role on the account.
# Example: https://<account>.queue.core.windows.net
# CLOUD_AGENT_AZURE_STORAGE_ACCOUNT_URL=

# Worker / queue tuning. Visibility timeout must exceed the worst-case agent
# execution time. max_retries is the default per-task retry budget (overridable
# at dispatch via the API / CLI). worker_concurrency is reserved for future
# concurrent processing — scale horizontally for now.
# CLOUD_AGENT_VISIBILITY_TIMEOUT_SECONDS=60
# CLOUD_AGENT_MAX_RETRIES=3
# CLOUD_AGENT_WORKER_CONCURRENCY=1
# CLOUD_AGENT_POLL_INTERVAL_SECONDS=1.0
